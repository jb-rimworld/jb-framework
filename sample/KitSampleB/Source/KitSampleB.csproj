<Project Sdk="Microsoft.NET.Sdk">
  <!-- JB.Kit sample B, tier full + test harness, stamped as an older kit version (kit.identity carries two kit versions). Build: tools/jbmod sample/KitSampleB build (add tests: tests flag). Output: ../1.7/Assemblies/KitSampleB.dll -->
  <PropertyGroup>
    <AssemblyName>KitSampleB</AssemblyName>
    <RootNamespace>KitSampleB</RootNamespace>
    <JBKit>full</JBKit>
    <JBKitVersion>0.9.0</JBKitVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)/../../../build/JBMod.props" />
</Project>
