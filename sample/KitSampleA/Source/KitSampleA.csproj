<Project Sdk="Microsoft.NET.Sdk">
  <!-- JB Framework sample A (a dependent mod). Build: dotnet build -c Release [-p:RimVersion=1.6]. Output: ../1.7/Assemblies/KitSampleA.dll -->
  <PropertyGroup>
    <AssemblyName>KitSampleA</AssemblyName>
    <RootNamespace>KitSampleA</RootNamespace>
    <!-- the missing-framework guard (build/JBGuard.props; LoadFolders.xml loads it only without the framework) -->
    <JBGuard>true</JBGuard>
    <JBGuardLoss>its sample settings</JBGuardLoss>
    <JBGuardLossDe>ihre Beispiel-Einstellungen</JBGuardLossDe>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)/../../../build/JBMod.props" />
</Project>
