<Project>
  <!--
    Build of a mod that USES JB Framework (a "dependent mod"). The only file such a mod imports. SPDX-License-Identifier: MIT

    Minimal csproj (at <Mod>/Source/<Mod>.csproj or <Mod>/Source/<Sub>/<Mod>.csproj):

      <Project Sdk="Microsoft.NET.Sdk">
        <PropertyGroup>
          <AssemblyName>LuciferiumOverhaul</AssemblyName>
          <RootNamespace>LuciferiumOverhaul</RootNamespace>
        </PropertyGroup>
        <Import Project="$(MSBuildProjectDirectory)/../../JBFramework/build/JBMod.props" />   (adjust ../ to reach the framework)
      </Project>

    Builds:
      dotnet build -c Release                      RimWorld 1.7: net10.0 into <Mod>/1.7/Assemblies (tested in game)
      dotnet build -c Release -p:RimVersion=1.6    RimWorld 1.6: net472 against Krafs.Rimworld.Ref 1.6.4871 into <Mod>/1.6/Assemblies
                                                   (compile-only, best effort; needs the framework's 1.6 DLL built first)
      -p:JBTests=true          defines JB_TESTS and references TestMod/<RimVersion>/Assemblies/JBFramework.Testing.dll (test suites; never in a release)
      -p:JBRelease=true        fails when JBTests=true
      -p:JBModRoot=DIR         mod folder (default: the parent of the "Source" folder above the csproj)
      -p:JBFrameworkDll=FILE   reference this JBFramework.dll instead of the one next to this file (<framework>/<RimVersion>/Assemblies)
      -p:JBMinApiLevel=N       API level stamped into the mod (default: the level of the framework it is built against)

    The framework DLL is referenced with Private=false: it is never copied into the mod (the framework mod provides it at runtime).
    Before compile, obj/<RimVersion>/JBModInfo.g.cs stamps [assembly: JBFramework.KitRequires(level, "version")] so an older installed
    framework can tell the player in plain words to update, without running the mod's code.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Identity.props" />
  <Import Project="$(MSBuildThisFileDirectory)JBCommon.props" />
  <PropertyGroup>
    <JBFrameworkRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</JBFrameworkRoot>
    <JBFrameworkDll Condition="'$(JBFrameworkDll)' == ''">$(JBFrameworkRoot)$(RimVersion)/Assemblies/$(JBFrameworkAssemblyName).dll</JBFrameworkDll>
    <JBMinApiLevel Condition="'$(JBMinApiLevel)' == ''">$(JBFrameworkApiLevel)</JBMinApiLevel>

    <!-- Mod root: the parent of the "Source" folder. Works for Source/x.csproj and Source/<Sub>/x.csproj. -->
    <_JBProjDirName>$([System.IO.Path]::GetFileName($(MSBuildProjectDirectory.TrimEnd('/').TrimEnd('\'))))</_JBProjDirName>
    <JBModRoot Condition="'$(JBModRoot)' == '' and '$(_JBProjDirName)' == 'Source'">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/..'))</JBModRoot>
    <JBModRoot Condition="'$(JBModRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/../..'))</JBModRoot>
    <JBModRoot>$([MSBuild]::EnsureTrailingSlash('$(JBModRoot)'))</JBModRoot>

    <OutputPath>$(JBModRoot)$(RimVersion)/Assemblies/</OutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1591;CS8632;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(JBFrameworkAssemblyName)"><HintPath>$(JBFrameworkDll)</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!-- Test builds only: the mod's own suites (#if JB_TESTS) derive from JBFramework.Testing.KitTestSuite. The harness DLL lives in the
       local test mod (TestMod/, never published); tools/jbmod loads that mod in test runs. Never copied into the mod. -->
  <PropertyGroup Condition="'$(JBTests)' == 'true'">
    <JBTestingDll Condition="'$(JBTestingDll)' == ''">$(JBFrameworkRoot)TestMod/$(RimVersion)/Assemblies/$(JBFrameworkAssemblyName).Testing.dll</JBTestingDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(JBTests)' == 'true'">
    <Reference Include="$(JBFrameworkAssemblyName).Testing"><HintPath>$(JBTestingDll)</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <Target Name="JBModInfo" BeforeTargets="CoreCompile;BeforeBuild">
    <Error Condition="'$(JBTests)' == 'true' and !Exists('$(JBTestingDll)')"
           Text="Test build: the harness $(JBTestingDll) is missing. Build it first: dotnet build $(JBFrameworkRoot)TestMod/Source -c Release (tools/jbmod does this)." />
    <Error Condition="!Exists('$(JBFrameworkDll)')"
           Text="$(JBFrameworkName) for RimWorld $(RimVersion) not found at $(JBFrameworkDll). Build it first: dotnet build $(JBFrameworkRoot)Source/JBFramework -c Release -p:RimVersion=$(RimVersion) (or pass -p:JBFrameworkDll=...)." />
    <PropertyGroup>
      <_JBModInfoFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)JBModInfo.g.cs</_JBModInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_JBModInfoLine Include="// &lt;auto-generated&gt; by $(JBFrameworkName) build/JBMod.props. Do not edit. SPDX-License-Identifier: MIT" />
      <_JBModInfoLine Include="[assembly: $(JBFrameworkNamespace).KitRequires($(JBMinApiLevel), &quot;$(JBFrameworkVersion)&quot;)]" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_JBModInfoFile)" Lines="@(_JBModInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(_JBModInfoFile)" />
      <Compile Include="$(_JBModInfoFile)" />
      <FileWrites Include="$(_JBModInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
