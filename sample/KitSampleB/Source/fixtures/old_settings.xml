<?xml version="1.0" encoding="utf-8"?>
<!-- A settings file as the mod would have written it BEFORE it adopted the kit (flat Scribe_Values fields).
     tools/jbmod (command migrate-test, option from = this file) copies it into the slot profile. -->
<SettingsBlock>
  <ModSettings Class="KitSampleB.KitSampleBSettings">
    <dailyBonus>7</dailyBonus>
    <growth>2.5</growth>
    <loud>True</loud>
    <Gamma_enabled>False</Gamma_enabled>
    <someRemovedField>42</someRemovedField>
  </ModSettings>
</SettingsBlock>
