<Project>
  <!-- JB.Kit build targets (imported by JBMod.props). SPDX-License-Identifier: MIT -->

  <!-- Writes obj/1.7/JBKitInfo.g.cs: kit version (VERSION file) and git state of _Shared/JBKit, compiled as part of KitInfo. -->
  <Target Name="JBKitInfo" BeforeTargets="CoreCompile;BeforeBuild" Condition="'$(_JBCore)' == 'true'">
    <PropertyGroup>
      <_JBKitVersion>$([System.IO.File]::ReadAllText('$(JBKitRoot)VERSION').Trim())</_JBKitVersion>
      <_JBKitInfoFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)JBKitInfo.g.cs</_JBKitInfoFile>
      <_JBTestsBool>false</_JBTestsBool>
      <_JBTestsBool Condition="'$(JBTests)' == 'true'">true</_JBTestsBool>
    </PropertyGroup>
    <Exec Command="git -C &quot;$(JBKitRoot)&quot; describe --always --dirty --abbrev=7" ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_JBKitCommitRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_JBKitGitExit" />
    </Exec>
    <PropertyGroup>
      <_JBKitCommit>$(_JBKitCommitRaw.Trim())</_JBKitCommit>
      <_JBKitCommit Condition="'$(_JBKitGitExit)' != '0' or '$(_JBKitCommit)' == '' or $(_JBKitCommit.Contains(' '))">unknown</_JBKitCommit>
    </PropertyGroup>
    <ItemGroup>
      <_JBKitInfoLine Include="// &lt;auto-generated&gt; by JBMod.targets. Do not edit. SPDX-License-Identifier: MIT" />
      <_JBKitInfoLine Include="namespace JBKit" />
      <_JBKitInfoLine Include="{" />
      <_JBKitInfoLine Include="    internal sealed partial class KitInfo" />
      <_JBKitInfoLine Include="    {" />
      <_JBKitInfoLine Include="        /// &lt;summary&gt;Kit version this DLL was built with (_Shared/JBKit/VERSION).&lt;/summary&gt;" />
      <_JBKitInfoLine Include="        internal const string KitVersion = &quot;$(_JBKitVersion)&quot;%3B" />
      <_JBKitInfoLine Include="        /// &lt;summary&gt;git describe of _Shared/JBKit at build time (&quot;unknown&quot; without git).&lt;/summary&gt;" />
      <_JBKitInfoLine Include="        internal const string KitCommit = &quot;$(_JBKitCommit)&quot;%3B" />
      <_JBKitInfoLine Include="        /// &lt;summary&gt;Kit tier of this build: core, lite or full.&lt;/summary&gt;" />
      <_JBKitInfoLine Include="        internal const string KitTier = &quot;$(JBKit)&quot;%3B" />
      <_JBKitInfoLine Include="        /// &lt;summary&gt;True when built with -p:JBTests=true.&lt;/summary&gt;" />
      <_JBKitInfoLine Include="        internal const bool KitTests = $(_JBTestsBool)%3B" />
      <_JBKitInfoLine Include="    }" />
      <_JBKitInfoLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_JBKitInfoFile)" Lines="@(_JBKitInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(_JBKitInfoFile)" />
      <Compile Include="$(_JBKitInfoFile)" />
      <FileWrites Include="$(_JBKitInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Validation: unknown tier, tests in a release, tests without kit -->
  <Target Name="JBReleaseGuard" BeforeTargets="CoreCompile;BeforeBuild">
    <Error Condition="'$(JBKit)' != 'none' and '$(JBKit)' != 'core' and '$(JBKit)' != 'lite' and '$(JBKit)' != 'full'"
           Text="JBKit must be none, core, lite or full (was '$(JBKit)')." />
    <Error Condition="'$(JBRelease)' == 'true' and '$(JBTests)' == 'true'"
           Text="Release build with JBTests=true: the test harness must never ship. Build without -p:JBTests=true." />
    <Warning Condition="'$(JBTests)' == 'true' and '$(JBKit)' == 'none'"
             Text="JBTests=true with JBKit=none: src/Core and src/Testing are compiled into this test build only." />
  </Target>
</Project>
