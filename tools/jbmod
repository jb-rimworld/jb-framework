#!/bin/bash
# SPDX-License-Identifier: MIT
# jbmod: one command per mod for build, in-game tests and release (JB Framework; spec SharedKit.md 3.2). Generalised from Hearth & Harbor
# tools/run_test.sh, run_plain.sh and run_saveload.sh. Tests run on RimWorld 1.7 only; 1.6 is compile-only (best effort). Never uploads, never pushes.
#
#   jbmod <Mod> build [--tests]                 1.7 build into <Mod>/1.7/Assemblies, then 1.6 (compile-only, NOT runnable here) into <Mod>/1.6/Assemblies.
#                                               --tests: 1.7 test build (JB_TESTS + JBFramework.Testing.dll) into the scratch folder only.
#                                               <Mod> = the framework: framework 1.7 + 1.6 and the local test mod (TestMod/).
#   jbmod <Mod> test <suites|all> [label] [extra…]
#                                               test build → one of the 3 shared slots → RimWorld -quicktest in an isolated profile
#                                               → RESULT, red-error report (ours/others). Exit 0 = every suite passed, no red error of ours.
#   jbmod <Mod> plain <seconds> [--days N|--no-day] [extra…]
#                                               release build, load without tests, the probe plays one day (--days N: N days; --no-day: the
#                                               probe only records red errors, the mod's own code drives the game and writes "PROBE DONE"
#                                               into $JB_PROBE_OUT): red errors, "did not load any content"
#   jbmod <Mod> play <days> [extra…]            = plain with --days <days> (timeout 300 s + 240 s per day unless TIMEOUT is set)
#   jbmod <Mod> saveload [label] [--suites S] [--build S] [--load S] [extra…]
#                                               save with the mod (kit.saveload) → load with the mod (fingerprint and values equal).
#                                               --suites S: the mod's own suites in both phases, --build S / --load S: in one phase only.
#                                               Order: phase 1 runs S before kit.saveload (it saves), phase 2 kit.saveload before S.
#   jbmod <Mod> twophase <label> <suites> [extra…]   new game with <suites> (one of them saves) → the same suites on that save
#   jbmod <Mod> removal [label] [--build S] [extra…]
#                                               load the saveload save WITHOUT the mod (the framework and the extras stay), probe plays 1 day:
#                                               "safe to remove?". Without a save of that label, phase 1 makes one (S, then kit.saveload).
#                                               Keeps the end save ($S/jb_saveload_<label>/removal_out/, name JB_PROBE_SAVE, default
#                                               jb_removal_end) and lists every colonist who died or left, with tick and health list.
#   jbmod <Mod> addition [label] [--suites S] [extra…]
#                                               vanilla save (no mod, no framework; the extras stay) → load WITH the mod: kit.smoke + kit.addition (+ S)
#   jbmod <Mod> compat <set> [label] [--suites S]
#                                               kit.smoke (+ S) with a named set of other mods (tools/compat_sets.json: packageIds or folders)
#   jbmod <Mod> load <save.rws> [label] [--suites S] [--days N] [--save NAME] [--no-mod] [--no-fw] [extra…]
#                                               load a GIVEN save (e.g. one made by an older build or a player's save) with the current build:
#                                               the suites run on it (test build), or without --suites the probe plays N days (default 1)
#   jbmod <Mod> noframework [label] [extra…]    the mod WITHOUT the framework (installed in the run, but switched off): only its guard may
#                                               load. Reports red errors and warnings (0 of ours), whether ONE guard window was shown (extra
#                                               local mods with a guard share it), screenshots (JB_UI_SHOTS=1), the manual route and a faked
#                                               Steam install that must leave ModsConfig with the framework directly above the first guarded mod.
#   jbmod <Mod> migrate-test [--from FILE] [--class ModClass] [label]
#                                               start with an OLD settings file (default: a copy of the player's Config/Mod_<folder>_<Class>.xml,
#                                               read only) and run kit.migration
#   jbmod <any> fw <tenants|removal|apilevel|alone|cards|all>
#                                               framework scenarios with sample/KitSampleA and sample/KitSampleB (suites fw.*); cards: the
#                                               welcome cards of RimWard, Luciferium Overhaul and Set my Defaults (+ Hospital Beds Gen 2)
#                                               in one colony, answered with injected clicks and keys (fw.cards; JB_UI_SHOTS for pictures)
#   jbmod <Mod> freeze16 [args] | lang [--write|--refresh] [args] | release [args] | desc-lint [args]
#                                               tools/freeze16.py, kit_lang.py (lang alone only checks; --write writes <XX>_Settings.xml
#                                               from Source/settings_dump.json; --refresh runs kit.settingsdump first), release.py, desc_lint.py
#
# <Mod>: a folder (absolute, relative to the current folder, to 22_RimWorld/ or to the framework, e.g. sample/KitSampleB; "JBFramework" or "."
#        of the framework = the framework itself). [extra…]: other mods for the run: a packageId (must be installed, e.g. a Workshop mod) or a
#        LOCAL mod folder (built and copied into the slot like the mod under test, packageId renamed).
# Every run gets the framework (a slot copy, packageId <fw>.slotN; dependents' About files are rewritten to it) and, when suites run, the
# local test mod TestMod/ (JBFramework.Testing.dll, <fw>.testing.slotN). The player's Mods folder never holds a framework of its own.
# Env: TIMEOUT=seconds (default 600) · BUILD=0 skip the builds · GAME_LANG=<language> (folder name, or its first word: German = "German
#      (Deutsch)"; default English) · JB_DLCS=all|none|<list> (default all; royalty,ideology,biotech,anomaly,odyssey or packageIds, comma or
#      space separated; knownExpansions keep all five, so no "new expansion" dialog) · JB_CSPROJ=<file>
#      JB_FRAMEWORK_DIR=<framework repo> (default: the repo of this script; framework, harness and every mod build use it)
#      KEEP_SLOT=1 keep the slot copies after the run (debug) · JB_UI_SHOTS=1 screenshots of kit.window into $S/jb_shots_<label>/
#      JB_MSBUILD_ARGS="-p:X=Y …" extra build properties for the mod under test only (fw apilevel uses -p:JBMinApiLevel=99).
# Isolation: fake HOME per slot under /private/tmp/claude-501/hh_tests/slotN (Prefs.xml copied read-only from the player's config, autosave
# off, volume 0, WAYLITH_BACKEND=offscreen: no window). The game's Mods folder only gets the symlinks _jb_slotN (mod), _jb_fwN (framework),
# _jb_tmN (test mod), _jb_probeN, _jb_xN_i (extra local mods), _jb_cN_i (compat mods from the cache), all removed by trap on exit.
# Slot locks /private/tmp/claude-501/hh_tests/lockN are shared with H&H and WPub (max 3 games at once). jbmod's own locks carry its PID
# and a heartbeat (stale only when the process is gone); locks of other tools count as stale after 25 minutes without a touch.
# The player's own profile is never written.
set -u
# the framework repo: JB_FRAMEWORK_DIR, else the repo this script lives in (so a git worktree of the framework tests its own build)
KIT="$(cd "${JB_FRAMEWORK_DIR:-$(dirname "$0")/..}" && pwd)"
[ -f "$KIT/build/Identity.props" ] || { echo "jbmod: $KIT is not a JB Framework repo (JB_FRAMEWORK_DIR)"; exit 2; }
export JB_FRAMEWORK_DIR="$KIT"                    # build/JBMod.props reads it too
RW="$(cd "$KIT/.." && pwd)"                       # 22_RimWorld (a worktree next to JBFramework sees the same mods)
S=/private/tmp/claude-501/hh_tests; mkdir -p "$S"
G="$HOME/Library/Application Support/Steam/steamapps/common/RimWorld"
REALCFG="$HOME/Library/Application Support/RimWorld/Config"      # read only
export PATH="$HOME/.dotnet:$PATH" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
idprop() { sed -n "s:.*<$1>\([^<]*\)</$1>.*:\1:p" "$KIT/build/Identity.props" | head -1; }
FWPID=$(idprop JBFrameworkPackageId); FWNAME=$(idprop JBFrameworkName); FWNS=$(idprop JBFrameworkNamespace); FWASM=$(idprop JBFrameworkAssemblyName)
TMPID="$FWPID.testing"
KITTAG=$(printf '%s' "$KIT" | cksum | awk '{print $1}')   # build folders of different framework checkouts never mix

# DLCs of a run (JB_DLCS): all (default), none, or a list of short names / packageIds
ALL_DLCS="ludeon.rimworld.royalty ludeon.rimworld.ideology ludeon.rimworld.biotech ludeon.rimworld.anomaly ludeon.rimworld.odyssey"
dlc_ids() {
  local v x; v=$(printf '%s' "${JB_DLCS:-all}" | tr '[:upper:]' '[:lower:]' | tr ',' ' ')
  case "$v" in all|"") echo $ALL_DLCS; return;; none) return;; esac
  for x in $v; do
    case "$x" in ludeon.rimworld.*) ;; *) x="ludeon.rimworld.$x";; esac
    case " $ALL_DLCS " in *" $x "*) echo "$x";; *) echo "jbmod: unknown DLC '$x' in JB_DLCS (royalty ideology biotech anomaly odyssey)" >&2; return 2;; esac
  done
}
dlc_ids >/dev/null || exit 2
# GAME_LANG: a language folder name, or its first word ("German" → "German (Deutsch)")
lang_folder() {
  local l=${GAME_LANG:-English} d="$G/Data/Core/Languages" f
  if [ -e "$d/$l" ] || [ -e "$d/$l.tar" ]; then echo "$l"; return; fi
  for f in "$d/$l ("*; do [ -e "$f" ] && { basename "$f" .tar; return; }; done
  echo "$l"
}
# one build at a time per machine (two runs of one mod, or of two mods that share the framework, must not swap DLLs under each other)
BL="$S/jbbuildlock"
build_lock() {
  local i p
  for i in $(seq 1 360); do
    if mkdir "$BL" 2>/dev/null; then echo $$ > "$BL/pid"; return 0; fi
    p=$(cat "$BL/pid" 2>/dev/null)
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -f "$BL/pid"; rmdir "$BL" 2>/dev/null; continue; fi
    [ -z "$p" ] && [ $(( $(date +%s) - $(stat -f %m "$BL" 2>/dev/null || date +%s) )) -gt 900 ] && { rmdir "$BL" 2>/dev/null; continue; }
    sleep 5
  done
  echo "jbmod: build lock $BL held too long"; return 3
}
build_unlock() { [ "$(cat "$BL/pid" 2>/dev/null)" = "$$" ] && { rm -f "$BL/pid"; rmdir "$BL" 2>/dev/null; }; return 0; }

usage() { sed -n '3,52p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -lt 2 ] && usage
MODARG=$1; CMD=$2; shift 2

# a mod folder for an argument (absolute, relative to here, to 22_RimWorld or to the framework), or empty
resolve_dir() { local c; for c in "$1" "$RW/$1" "$KIT/$1"; do [ -d "$c/About" ] && { (cd "$c" && pwd); return; }; done; }
pid_of() { sed -n 's:.*<packageId>\([^<]*\)</packageId>.*:\1:p' "$1/About/About.xml" | head -1; }

# ---------------------------------------------------------------------------------------------------------------- mod facts
MOD=$(resolve_dir "$MODARG")
[ -z "$MOD" ] && { echo "jbmod: no mod folder with About/ found for '$MODARG'"; exit 2; }
IS_FW=0; [ "$MOD" = "$KIT" ] && IS_FW=1
MODNAME=$(basename "$MOD")
ABOUT="$MOD/About/About.xml"
PID=$(pid_of "$MOD")
PIDL=$(echo "$PID" | tr '[:upper:]' '[:lower:]')
DISPLAY_NAME=$(sed -n 's:.*<name>\([^<]*\)</name>.*:\1:p' "$ABOUT" | head -1)
[ -z "$PID" ] && { echo "jbmod: no packageId in $ABOUT"; exit 2; }

find_csprojs() {   # <moddir>
  local m=$1
  if [ "$m" = "$MOD" ] && [ -n "${JB_CSPROJ:-}" ]; then echo "$JB_CSPROJ"; return; fi
  [ -d "$m/Source" ] || return
  local all kit f
  all=$(find "$m/Source" -name '*.csproj' -not -path '*/obj/*' -not -path '*/bin/*' -not -path '*/_frozen16/*' 2>/dev/null)
  kit=$(echo "$all" | while read -r f; do [ -n "$f" ] && grep -l 'JBMod.props' "$f" 2>/dev/null; done)
  if [ -n "$kit" ]; then echo "$kit"; return; fi
  local rw17; rw17=$(echo "$all" | grep '\.rw17\.csproj$')
  if [ -n "$rw17" ]; then echo "$rw17"; return; fi
  [ "$(echo "$all" | grep -c .)" = 1 ] && echo "$all"
}
CSPROJS=$(find_csprojs "$MOD")
asm_of() { local a; a=$(sed -n 's:.*<AssemblyName>\([^<]*\)</AssemblyName>.*:\1:p' "$1" | head -1); [ -z "$a" ] || [[ "$a" == *'$('* ]] && a=$(basename "$1" .csproj | sed 's/\.rw17$//'); echo "$a"; }
ns_of() { sed -n 's:.*<RootNamespace>\([^<]*\)</RootNamespace>.*:\1:p' "$1" | grep -v '\$(' | head -1; }
ASMS=""; NSS=""
for cs in $CSPROJS; do ASMS="$ASMS $(asm_of "$cs")"; NSS="$NSS $(ns_of "$cs")"; done
if [ -d "$MOD/Source" ]; then   # namespaces actually declared in the code
  NSS="$NSS $(grep -rhoE '^[[:space:]]*namespace [A-Za-z0-9_.]+' "$MOD/Source" --include='*.cs' 2>/dev/null | awk '{print $2}' | sort -u | tr '\n' ' ')"
fi
mod_class() {   # the Verse.Mod subclass: names the settings file Mod_<folder>_<Class>.xml
  grep -rhoE 'class [A-Za-z0-9_]+ *: *(JBFramework\.)?(KitModBase|Mod)\b' "$MOD/Source" --include='*.cs' 2>/dev/null | head -1 | awk '{print $2}'
}

# ---------------------------------------------------------------------------------------------------------------- builds
# dotnet build with an error/warning digest. A failure is retried once after 60 s (another agent may be half-way through a file).
dn_build() {   # <log> <args…>
  local log=$1; shift
  dotnet build "$@" -v q -nologo > "$log" 2>&1; local c=$?
  if [ $c != 0 ] && [ "${JB_NO_RETRY:-0}" != 1 ]; then
    echo "build failed ($(basename "$log")), retrying in 60 s:"; grep -E ': error ' "$log" | sed 's#^.*/\([^/]*\.cs\)#\1#' | sort -u | head -5
    sleep 60; dotnet build "$@" -v q -nologo > "$log" 2>&1; c=$?
  fi
  grep -E ': (error|warning) ' "$log" | sed 's#^.*/\([^/]*\.cs\)#\1#' | sort -u | head -40
  [ $c != 0 ] && { echo "BUILD FAILED (exit $c, log $log)"; tail -5 "$log"; }
  return $c
}

build_framework() {   # [RimVersion]
  local v=${1:-1.7}
  dn_build "$S/jb_build_framework_$v.txt" "$KIT/Source/JBFramework" -c Release "-p:RimVersion=$v" || return 2
}
build_testing() { dn_build "$S/jb_build_testing.txt" "$KIT/TestMod/Source" -c Release || return 2; }

# build_mod <moddir> <tests 0|1> <outdir|-> <RimVersion> [extra msbuild args…]: every project of a dependent mod; outdir "-" = the projects' own output
build_mod() {
  local m=$1 tests=$2 out=$3 v=$4; shift 4
  local projs rc=0 cs; projs=$(find_csprojs "$m")
  [ -z "$projs" ] && { echo "jbmod: no csproj under $m/Source (set JB_CSPROJ)"; return 2; }
  for cs in $projs; do
    # a global JBFrameworkRoot wins over the csproj/props value: every mod builds against THIS framework and harness (worktree-safe)
    local args=("$cs" -c Release "-p:RimVersion=$v" "-p:JBFrameworkRoot=$KIT/")
    [ "$tests" = 1 ] && args+=(-p:JBTests=true "-p:IntermediateOutputPath=obj/${v}jbtest/")
    [ "$out" != "-" ] && { mkdir -p "$out"; args+=("-p:OutputPath=$out/"); }
    # the missing-framework guard (build/JBGuard.props) is built by explicit builds (jbmod build, release.py) and by noframework runs only
    if [ "$out" != "-" ]; then if [ -n "${GUARD_ARGS:-}" ]; then args+=($GUARD_ARGS "-p:JBGuardOutputPath=$out/guard/"); else args+=(-p:JBGuardBuild=false); fi; fi
    dn_build "$S/jb_build_$(basename "$m")_$(basename "$cs" .csproj)_$v$([ "$tests" = 1 ] && echo _tests).txt" "${args[@]}" "$@" || rc=2
  done
  return $rc
}

ensure_probe() {
  local dll="$KIT/tools/probe/bin/1.7/Assemblies/JBProbe.dll"
  if [ ! -f "$dll" ] || [ "$KIT/tools/probe/Probe.cs" -nt "$dll" ]; then
    dotnet build "$KIT/tools/probe/JBProbe.csproj" -c Release -v q -nologo > "$S/jb_build_probe.txt" 2>&1 || { grep -E ' error ' "$S/jb_build_probe.txt" | sort -u; echo "PROBE BUILD FAILED"; return 2; }
  fi
}

# ---------------------------------------------------------------------------------------------------------------- slots
slot=""
# Lock = the directory lockN. jbmod writes its PID into lockN/pid and touches the directory every 60 s while it runs (heartbeat), so
# the 25-minute rule of the other tools (H&H run_test.sh, WPub) never takes a long jbmod run's slot. A lock with a pid file is stale only
# when that process is gone; a lock without one (another tool) keeps the old rule: stale when not touched for 25 minutes.
HB=""
lock_stale() {   # <n>
  local d="$S/lock$1" p
  [ -d "$d" ] || return 1
  if [ -f "$d/pid" ]; then p=$(cat "$d/pid" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && return 1; return 0; fi
  local mt; mt=$(stat -f %m "$d" 2>/dev/null) || return 1   # the lock can vanish between the two checks (another run released it)
  [ $(( $(date +%s) - mt )) -gt 1500 ]
}
acquire_slot() {
  local i n
  for i in $(seq 1 720); do
    for n in 1 2 3; do
      if mkdir "$S/lock$n" 2>/dev/null; then
        slot=$n; echo $$ > "$S/lock$n/pid"
        # links a hard-killed earlier run left behind in this slot (we hold its lock now, so nobody else uses them)
        rm -f "$G/Mods/_jb_slot$n" "$G/Mods/_jb_probe$n" "$G/Mods/_jb_fw$n" "$G/Mods/_jb_tm$n" "$G/Mods/_jb_c${n}_"* "$G/Mods/_jb_x${n}_"* 2>/dev/null
        ( while [ -f "$S/lock$n/pid" ] && [ "$(cat "$S/lock$n/pid" 2>/dev/null)" = "$$" ] && kill -0 $$ 2>/dev/null; do touch "$S/lock$n"; sleep 60; done ) >/dev/null 2>&1 &
        HB=$!
        return 0
      fi
    done
    for n in 1 2 3; do lock_stale $n && { rm -f "$S/lock$n/pid"; rmdir "$S/lock$n" 2>/dev/null; }; done
    sleep 5
  done
  echo "no free test slot"; return 3
}
release_slot() {
  [ -z "$slot" ] && return
  rm -f "$G/Mods/_jb_slot$slot" "$G/Mods/_jb_probe$slot" "$G/Mods/_jb_fw$slot" "$G/Mods/_jb_tm$slot" "$G/Mods/_jb_c${slot}_"* "$G/Mods/_jb_x${slot}_"* 2>/dev/null
  [ "${KEEP_SLOT:-0}" = 1 ] || rm -rf "$S/slot$slot/mod" "$S/slot$slot/probe" "$S/slot$slot/fw" "$S/slot$slot/tm" "$S/slot$slot/x_"*
  [ -n "$HB" ] && { kill "$HB" 2>/dev/null; HB=""; }
  [ "$(cat "$S/lock$slot/pid" 2>/dev/null)" = "$$" ] && rm -f "$S/lock$slot/pid"
  rmdir "$S/lock$slot" 2>/dev/null
  slot=""
}
trap release_slot EXIT
trap 'release_slot; exit 130' INT TERM

# slot_copy <src> <dst> <newPackageId> [extra rsync excludes…]: content copy (no sources), packageId renamed, the framework dependency
# pointed at this slot's framework copy, incompatibleWith dropped (a slot copy must load next to the player's real mods).
slot_copy() {
  local src=$1 dst=$2 newpid=$3; shift 3
  rm -rf "$dst"; mkdir -p "$dst"
  rsync -a --delete --exclude /Source --exclude /Workshop --exclude /tools --exclude .git --exclude /docs --exclude /_scratch \
    --exclude obj/ --exclude bin/ --exclude '*.csproj' --exclude '*.pre-kit' "$@" "$src/" "$dst/"
  local old; old=$(pid_of "$src")
  sed -i '' -e "s#<packageId>$old</packageId>#<packageId>$newpid</packageId>#" \
    -e "s#>$FWPID<#>$FWPID.slot$slot<#g" -e '/<incompatibleWith>/,/<\/incompatibleWith>/d' "$dst/About/About.xml"
  grep -q "<packageId>$newpid</packageId>" "$dst/About/About.xml" || { echo "could not rename the packageId in the slot copy of $(basename "$src")"; return 2; }
  # LoadFolders.xml conditions name the framework by packageId: point them at this slot's copy (vanilla compares exactly)
  if [ -f "$dst/LoadFolders.xml" ]; then
    python3 -I - "$dst/LoadFolders.xml" "$FWPID" "$FWPID.slot$slot" <<'PY2'
import re, sys
p, old, new = sys.argv[1:4]; s = open(p, encoding="utf-8").read()
def attr(m):
    ids = [x.strip() for x in m.group(2).split(",")]
    return m.group(1) + ",".join(new if x.lower() == old else x for x in ids) + '"'
t = re.sub(r'(IfMod(?:Active|ActiveAll|NotActive)=")([^"]*)"', attr, s)
if t != s: open(p, "w", encoding="utf-8").write(t)
PY2
  fi
}

# ---------------------------------------------------------------------------------------------------------------- red-error report
# report_errors <probe file> → prints ours/others/noise; sets OURS (count of ours), OURS_PLAY. "Ours" = the framework or the mod under test.
OURS=0; OURS_PLAY=0
report_errors() {
  local f=$1
  OURS=0; OURS_PLAY=0
  [ -f "$f" ] || { echo "--- red errors: no probe file"; return; }
  local markers="" a
  for a in $ASMS $NSS; do markers="$markers|$a."; done
  markers="$markers|[$DISPLAY_NAME]|$PIDL|$FWNS.|[$FWNAME]|$FWPID|$FWASM.dll"
  # fragments the suites announced with TestContext.ExpectRedError (the harness writes them to <probe file>.expected)
  awk -F'\t' -v M="${markers#|}" -v O="$f.ours" -v X="$f.others" -v N="$f.noise" -v E="$f.expected" '
    BEGIN { n = split(M, m, "|"); printf "" > O; printf "" > X; printf "" > N
            ne = 0; while ((getline x < E) > 0) if (x != "") ex[++ne] = x }
    { line = tolower($0); ours = 0
      if ($0 ~ /\[JBTEST-EXPECTED\]|jbtest_expected/) { print > N; next }
      for (i = 1; i <= ne; i++) if (index($0, ex[i]) > 0) { print > N; next }
      for (i = 1; i <= n; i++) if (m[i] != "" && index(line, tolower(m[i])) > 0) { ours = 1; break }
      if (ours) print > O
      else if ($0 ~ /Root level exception in OnGUI|get_UIScale/) print > N
      else print > X }' "$f"
  OURS=$(grep -c . "$f.ours"); OURS_PLAY=$(grep -c '^play' "$f.ours")
  echo "--- red errors: ours $OURS (load $(grep -c '^load' "$f.ours"), play $OURS_PLAY) · others $(grep -c . "$f.others") · noise/expected $(grep -c . "$f.noise")   [$f]"
  [ "$OURS" -gt 0 ] && { echo "    ours (first 20):"; head -20 "$f.ours" | cut -c1-400 | sed 's/^/      /'; }
  [ -s "$f.others" ] && { echo "    others (count × phase/type/text):"; cut -f1-3 "$f.others" | sort | uniq -c | sort -rn | head -15 | cut -c1-300 | sed 's/^/      /'; }
  return 0
}

# ---------------------------------------------------------------------------------------------------------------- one game run
# Inputs (globals): LABEL SUITES LOAD NO_MOD NO_FW PROBE_DAYS PROBE_SAVE SAVES_OUT KIND(tests|plain) MIGRATION_FROM COMPAT_LINKS[@] EXTRA[@] TIMEOUT_S
# Output: RUN_RC (0 pass), files $S/jb_*_$LABEL.*
run_slot() {
  # build output per mod, kind and run label (BUILDKEY: the label shared by the phases of one save round trip), so two runs of the
  # same mod at once never delete or swap each other's DLL
  local BKEY="${BUILDKEY:-$LABEL}"
  local BUILDOUT="$S/jbbuild_${MODNAME}_${KIND}_${BKEY}_$KITTAG" e i
  RUN_RC=0; LOG=/dev/null
  [ "$NO_FW" = 1 ] && NO_TM=1
  [ -n "$SUITES" ] || NO_TM=1
  # local extra mods: folders → built (release) and copied like the mod under test; the rest are packageIds
  # (a folder without Source/ is a prebuilt mod, e.g. one specific Workshop or cache item: linked as is, packageId kept); packageIds
  # are resolved like `compat` does (game Mods, Workshop, then the Rimling cache, linked) and written lower-case into ModsConfig.xml
  local XDIRS=() XIDS=() LINKS=() ORD=() kind xp xd line
  for e in ${EXTRA[@]+"${EXTRA[@]}"}; do
    local d; d=$(resolve_dir "$e")
    if [ -n "$d" ] && [ -n "$(find_csprojs "$d")" ]; then XDIRS+=("$d"); ORD+=("D${#XDIRS[@]}"); continue; fi
    line=$(python3 -I "$KIT/tools/resolve_mods.py" "${d:-$e}")
    kind=${line%% *}; xp=$(echo "$line" | awk '{print $2}'); xd=$(echo "$line" | cut -d' ' -f3-)
    case "$kind" in
      GAME) XIDS+=("$xp"); ORD+=("I$xp") ;;
      CACHE|DIR) XIDS+=("$xp"); ORD+=("I$xp"); LINKS+=("$xd"); echo "extra $xp: $(echo "$kind" | tr '[:upper:]' '[:lower:]') folder $xd (linked for this run)" ;;
      *) XIDS+=("$(echo "$e" | tr '[:upper:]' '[:lower:]')"); ORD+=("I$(echo "$e" | tr '[:upper:]' '[:lower:]')"); echo "jbmod: extra '$e' is not installed and not in the cache; the game will skip it" ;;
    esac
  done
  for e in ${COMPAT_LINKS[@]+"${COMPAT_LINKS[@]}"}; do LINKS+=("$e"); done
  if [ "${BUILD:-1}" = 1 ]; then
    build_lock || { RUN_RC=3; return; }
    # the framework is built for every run that loads it, and for a guard run (the mod compiles against it; it is installed but off)
    if [ "$NO_FW" != 1 ] || [ "${GUARD_RUN:-0}" = 1 ]; then build_framework 1.7 || { build_unlock; RUN_RC=2; return; }; fi
    if [ "${NO_TM:-0}" != 1 ]; then build_testing || { build_unlock; RUN_RC=2; return; }; fi
    if [ "$NO_MOD" != 1 ] && [ "$IS_FW" != 1 ]; then
      rm -rf "$BUILDOUT"
      # shellcheck disable=SC2086
      build_mod "$MOD" $([ "$KIND" = tests ] && echo 1 || echo 0) "$BUILDOUT" 1.7 ${JB_MSBUILD_ARGS:-} || { build_unlock; RUN_RC=2; return; }
    fi
    for d in ${XDIRS[@]+"${XDIRS[@]}"}; do
      [ -d "$d/Source" ] || continue
      local xo="$S/jbbuild_x_$(basename "$d")_${BKEY}_$KITTAG"
      rm -rf "$xo"; build_mod "$d" 0 "$xo" 1.7 || { build_unlock; RUN_RC=2; return; }
    done
    build_unlock
  fi
  if [ "$NO_MOD" != 1 ] && [ "$IS_FW" != 1 ] && ! ls "$BUILDOUT"/*.dll >/dev/null 2>&1; then echo "no build output in $BUILDOUT (run without BUILD=0 first)"; RUN_RC=2; return; fi
  ensure_probe || { RUN_RC=2; return; }
  acquire_slot || { RUN_RC=3; return; }
  local SD="$S/slot$slot"; mkdir -p "$SD"
  build_lock || { RUN_RC=3; return; }   # the copies below read the framework and harness DLLs another run may be rebuilding
  local SLOTPID="$PIDL.slot$slot" modid="" probeid="juliusberger00.jbprobe.slot$slot" fwid="" tmid="" xids=()
  if [ "$NO_FW" != 1 ] || [ "${GUARD_RUN:-0}" = 1 ]; then
    slot_copy "$KIT" "$SD/fw" "$FWPID.slot$slot" --exclude /TestMod --exclude /sample --exclude /build --exclude /api --exclude /src --exclude /guard --exclude '/*.md' || { RUN_RC=2; return; }
    ln -sfn "$SD/fw" "$G/Mods/_jb_fw$slot"
    # guard run: the framework is INSTALLED (the item a Steam install would bring) but not in the active mod list
    [ "$NO_FW" != 1 ] && fwid="$FWPID.slot$slot"
  fi
  if [ "${NO_TM:-0}" != 1 ]; then
    slot_copy "$KIT/TestMod" "$SD/tm" "$TMPID.slot$slot" || { RUN_RC=2; return; }
    ln -sfn "$SD/tm" "$G/Mods/_jb_tm$slot"; tmid="$TMPID.slot$slot"
  fi
  if [ "$NO_MOD" != 1 ]; then
    if [ "$IS_FW" = 1 ]; then
      [ -z "$fwid" ] && { echo "the framework is the mod under test: it cannot be left out"; RUN_RC=2; return; }
    else
      slot_copy "$MOD" "$SD/mod" "$SLOTPID" || { RUN_RC=2; return; }
      mkdir -p "$SD/mod/1.7/Assemblies"; cp "$BUILDOUT"/*.dll "$SD/mod/1.7/Assemblies/"
      # guard run: the guard test build (test seam) replaces the release guard of the source tree
      if [ "${GUARD_RUN:-0}" = 1 ]; then
        ls "$BUILDOUT"/guard/*.dll >/dev/null 2>&1 || { echo "no guard build in $BUILDOUT/guard (does the csproj set <JBGuard>true</JBGuard>?)"; RUN_RC=2; return; }
        rm -rf "$SD/mod/Guard/1.7/Assemblies"; mkdir -p "$SD/mod/Guard/1.7/Assemblies"; cp "$BUILDOUT"/guard/*.dll "$SD/mod/Guard/1.7/Assemblies/"
      fi
      ln -sfn "$SD/mod" "$G/Mods/_jb_slot$slot"; modid=$SLOTPID
    fi
  fi
  build_unlock
  i=0
  local xplain="" DSLOT=()
  for d in ${XDIRS[@]+"${XDIRS[@]}"}; do
    i=$((i+1)); local xp; xp=$(pid_of "$d" | tr '[:upper:]' '[:lower:]')
    slot_copy "$d" "$SD/x_$i" "$xp.slot$slot" || { RUN_RC=2; return; }
    local xo="$S/jbbuild_x_$(basename "$d")_${BKEY}_$KITTAG"
    if ls "$xo"/*.dll >/dev/null 2>&1; then mkdir -p "$SD/x_$i/1.7/Assemblies"; cp "$xo"/*.dll "$SD/x_$i/1.7/Assemblies/"; fi
    if [ "${GUARD_RUN:-0}" = 1 ] && ls "$xo"/guard/*.dll >/dev/null 2>&1; then mkdir -p "$SD/x_$i/Guard/1.7/Assemblies"; cp "$xo"/guard/*.dll "$SD/x_$i/Guard/1.7/Assemblies/"; fi
    ln -sfn "$SD/x_$i" "$G/Mods/_jb_x${slot}_$i"; DSLOT[$i]="$xp.slot$slot"; xplain="$xplain,$xp"
  done
  for e in ${XIDS[@]+"${XIDS[@]}"}; do xplain="$xplain,$e"; done
  # extras keep their command-line order in ModsConfig (local folders and packageIds mixed as given)
  for e in ${ORD[@]+"${ORD[@]}"}; do case "$e" in D*) xids+=("${DSLOT[${e#D}]}");; I*) xids+=("${e#I}");; esac; done
  rm -rf "$SD/probe"; mkdir -p "$SD/probe/About" "$SD/probe/1.7"; cp -R "$KIT/tools/probe/bin/1.7/Assemblies" "$SD/probe/1.7/"
  printf '<?xml version="1.0" encoding="utf-8"?>\n<ModMetaData><name>JB probe (tests)</name><author>juliusberger00</author><packageId>%s</packageId><supportedVersions><li>1.7</li></supportedVersions><description>Test-only.</description></ModMetaData>\n' "$probeid" > "$SD/probe/About/About.xml"
  ln -sfn "$SD/probe" "$G/Mods/_jb_probe$slot"
  i=0
  for d in ${LINKS[@]+"${LINKS[@]}"}; do i=$((i+1)); ln -sfn "$d" "$G/Mods/_jb_c${slot}_$i"; done

  local FH="$SD/home"; local C="$FH/Library/Application Support/RimWorld/Config"; rm -rf "$FH"; mkdir -p "$C"
  cp "$REALCFG/Prefs.xml" "$C/" 2>/dev/null
  if [ -f "$C/Prefs.xml" ]; then
    sed -i ''       -e "s#<langFolderName>[^<]*</langFolderName>#<langFolderName>$(lang_folder)</langFolderName>#" \
      -e "s#<autosaveIntervalDays>[^<]*</autosaveIntervalDays>#<autosaveIntervalDays>1000</autosaveIntervalDays>#" \
      -e "s#<runInBackground>[^<]*</runInBackground>#<runInBackground>True</runInBackground>#" \
      -e 's#<volumeMaster>[^<]*</volumeMaster>#<volumeMaster>0</volumeMaster>#' "$C/Prefs.xml"
  fi
  local QT=-quicktest
  [ "${GUARD_RUN:-0}" = 1 ] && QT=""   # the guard shows its window at the main menu
  unset JB_TEST_LOAD JB_GUARD_TEST JB_GUARD_FWID JB_GUARD_FAKE_STEAM
  if [ -n "$LOAD" ]; then
    sed -i '' -e "s#<devMode>[^<]*</devMode>#<devMode>True</devMode>#" -e "s#<pauseOnLoad>[^<]*</pauseOnLoad>#<pauseOnLoad>False</pauseOnLoad>#" "$C/Prefs.xml"
    local SV="$FH/Library/Application Support/RimWorld/Saves"; mkdir -p "$SV"; cp "$(dirname "$LOAD")"/* "$SV/"; cp "$LOAD" "$SV/autostart.rws"
    export JB_TEST_LOAD=$(basename "$LOAD" .rws); QT=""
  fi
  unset JB_TEST_MIGRATION
  if [ -n "${MIGRATION_FROM:-}" ]; then
    local mc; mc=${MIGRATION_CLASS:-$(mod_class)}
    [ -z "$mc" ] && { echo "could not find the Mod class (pass --class)"; RUN_RC=2; return; }
    cp "$MIGRATION_FROM" "$C/Mod__jb_slot${slot}_${mc}.xml"; cp "$MIGRATION_FROM" "$S/jb_migration_$LABEL.xml"
    export JB_TEST_MIGRATION="$S/jb_migration_$LABEL.xml"
  fi
  local V; V=$(sed -n 's/.*<version>\(.*\)<\/version>.*/\1/p' "$REALCFG/ModsConfig.xml" 2>/dev/null | head -1)
  { echo '<?xml version="1.0" encoding="utf-8"?><ModsConfigData><version>'"$V"'</version><activeMods>'
    # the probe first (it records red errors from the earliest mod constructor on), then the framework, the harness, extras, the mod
    # shellcheck disable=SC2046
    for p in brrainz.harmony ludeon.rimworld $(dlc_ids) \
             $probeid $fwid $tmid ${xids[@]+"${xids[@]}"} $modid; do echo "<li>$p</li>"; done
    echo '</activeMods><knownExpansions><li>ludeon.rimworld.royalty</li><li>ludeon.rimworld.ideology</li><li>ludeon.rimworld.biotech</li><li>ludeon.rimworld.anomaly</li><li>ludeon.rimworld.odyssey</li></knownExpansions></ModsConfigData>'; } > "$C/ModsConfig.xml"

  OUT="$S/jb_result_$LABEL.txt"; LOG="$S/jb_player_$LABEL.log"; PERR="$S/jb_probe_err_$LABEL.txt"; POUT="$S/jb_probe_$LABEL.txt"
  GOUT="$S/jb_guard_$LABEL.txt"; PWARN="$S/jb_probe_warn_$LABEL.txt"
  rm -f "$OUT" "$PERR" "$POUT" "$PERR".* "$GOUT" "$PWARN" "$PWARN".*
  [ "${GUARD_RUN:-0}" = 1 ] && export JB_GUARD_TEST="$GOUT" JB_GUARD_FWID="$FWPID.slot$slot"
  export JB_PROBE_WARN="$PWARN"
  export JB_PROBE_ERR="$PERR" JB_PROBE_OUT="$POUT" JB_TEST_DUMP="$S/jb_settings_dump_$LABEL.json" JB_TEST_EXTRA="${xplain#,}"
  if [ -n "$PROBE_DAYS" ]; then export JB_PROBE_DAYS=$PROBE_DAYS; else unset JB_PROBE_DAYS; fi
  if [ -n "$PROBE_SAVE" ]; then export JB_PROBE_SAVE=$PROBE_SAVE; else unset JB_PROBE_SAVE; fi
  local shots=""
  if [ -n "${JB_UI_SHOTS:-}" ] && [ "${JB_UI_SHOTS}" != 0 ]; then shots="$S/jb_shots_$LABEL"; rm -rf "$shots"; mkdir -p "$shots"; fi
  local testmod=$PIDL; [ "$IS_FW" = 1 ] && testmod=$FWPID
  local started; started=$(date +%s)
  # test instances run without a window (engine offscreen backend, virtual 1920x1080 screen) and muted; see _Tools/rwquiet/README.md
  ( cd "$G/RimWorld.app/Contents/MacOS" && HOME="$FH" JB_TEST="$SUITES" JB_TEST_OUT="$OUT" JB_TEST_MOD="$testmod" JB_UI_SHOTS="$shots" \
      timeout "${TIMEOUT_S:-${TIMEOUT:-600}}" env WAYLITH_BACKEND=offscreen ./RimWorld $QT > "$LOG" 2>&1 )
  local code=$?
  if [ -n "$SAVES_OUT" ]; then mkdir -p "$SAVES_OUT"; cp "$FH/Library/Application Support/RimWorld/Saves/"* "$SAVES_OUT/" 2>/dev/null; rm -f "$SAVES_OUT/autostart.rws"; fi
  rm -rf "$S/jb_logs_$LABEL"; mkdir -p "$S/jb_logs_$LABEL"; cp "$C"/*.log "$C"/Mod_*.xml* "$S/jb_logs_$LABEL/" 2>/dev/null
  cp "$C/ModsConfig.xml" "$S/jb_logs_$LABEL/ModsConfig_after.xml" 2>/dev/null
  echo "slot $slot · game exit $code · $(( $(date +%s) - started )) s · log $LOG · mod logs $S/jb_logs_$LABEL/"
  echo "mods: framework ${fwid:-(none)} · harness ${tmid:-(none)} · extras ${xids[*]+${xids[*]}} · under test ${modid:-${fwid:-(none)}} · DLCs ${JB_DLCS:-all} · language $(lang_folder)"
  release_slot
  grep -E "^\[JBTEST\].*(starting|RESULT)|did not load any content|^\[JBPROBE\] (running|done)" "$LOG" | sed 's/\x1b\[[0-9;]*m//g' | head -10
  report_errors "$PERR"
  [ -n "$shots" ] && echo "screenshots: $shots ($(ls "$shots" 2>/dev/null | grep -c png))"
  if [ "${GUARD_RUN:-0}" = 1 ]; then
    report_errors "$PWARN" >/dev/null; WOURS=$OURS; report_errors "$PERR" >/dev/null
    echo "--- warnings: ours $WOURS · all $(grep -c . "$PWARN" 2>/dev/null)   [$PWARN]"
    [ "$WOURS" -gt 0 ] && head -10 "$PWARN.ours" | cut -c1-300 | sed 's/^/      /'
    if [ -f "$GOUT" ]; then sed 's/^/  /' "$GOUT"; grep -q '^GUARD PASS' "$GOUT" || RUN_RC=1
    else echo "NO GUARD REPORT (the guard window never ran its test seam: crash, timeout, or the guard did not load)"; tail -30 "$LOG"; RUN_RC=4; fi
    [ "$OURS" -gt 0 ] && { echo "FAIL: $OURS red error(s) of ours"; [ $RUN_RC = 0 ] && RUN_RC=1; }
    [ "$WOURS" -gt 0 ] && { echo "FAIL: $WOURS warning(s) of ours"; [ $RUN_RC = 0 ] && RUN_RC=1; }
  elif [ -n "$SUITES" ]; then
    if [ -f "$OUT" ]; then head -200 "$OUT"; grep -q "^RESULT PASS" "$OUT" || RUN_RC=1
    else echo "NO RESULT FILE (crash or timeout)"; tail -30 "$LOG"; RUN_RC=4; fi
    [ "$OURS" -gt 0 ] && { echo "FAIL: $OURS red error(s) of ours"; [ $RUN_RC = 0 ] && RUN_RC=1; }
  else
    if [ -f "$POUT" ] && grep -q "^PROBE DONE" "$POUT"; then cat "$POUT"; else echo "PROBE DID NOT FINISH"; tail -20 "$LOG"; RUN_RC=4; fi
  fi
}

defaults() { GUARD_RUN=0; GUARD_ARGS=""; SUITES=""; LOAD=""; NO_MOD=0; NO_FW=0; NO_TM=0; PROBE_DAYS=""; PROBE_SAVE=""; SAVES_OUT=""; KIND=tests; MIGRATION_FROM=""; COMPAT_LINKS=(); EXTRA=(); TIMEOUT_S=""; }
py() { python3 -I "$KIT/tools/$1" "${@:2}"; }
newest_save() { ls -t "$1"/*.rws 2>/dev/null | grep -v '/autostart.rws$' | head -1; }

# two_phase <label> <suites phase 1> <suites phase 2> <extras phase 1…> -- <extras phase 2…>: new game (a suite saves) → load that
# save (the suites compare). Both phases share one build (BUILDKEY = label).
two_phase() {
  local L=$1 SU1=$2 SU2=$3; shift 3
  local E1=() E2=() second=0 x
  for x in "$@"; do if [ "$x" = "--" ]; then second=1; elif [ $second = 0 ]; then E1+=("$x"); else E2+=("$x"); fi; done
  local D="$S/jb_saveload_$L"; mkdir -p "$D"
  BUILDKEY=$L
  defaults; LABEL="${L}_build"; SUITES=$SU1; SAVES_OUT="$D/build"; EXTRA=(${E1[@]+"${E1[@]}"}); rm -rf "$D/build"
  echo "== phase 1: new game with $MODNAME ${E1[*]+${E1[*]}} → save ($SU1)"; run_slot; local rc1=$RUN_RC
  local sv; sv=$(newest_save "$D/build")
  [ -z "$sv" ] && { echo "phase 1 made no save"; return 1; }
  [ $rc1 != 0 ] && { echo "phase 1 failed ($rc1)"; return $rc1; }
  defaults; LABEL="${L}_load"; SUITES=$SU2; LOAD=$sv; SAVES_OUT="$D/load"; EXTRA=(${E2[@]+"${E2[@]}"})
  echo "== phase 2: load $(basename "$sv") with $MODNAME ${E2[*]+${E2[*]}} ($SU2)"; BUILD=0 run_slot; return $RUN_RC
}

# is_label <arg>: a run label (no dot, no option, not a mod folder) rather than an extra mod
is_label() { [[ "$1" != *.* ]] && [[ "$1" != --* ]] && [ -z "$(resolve_dir "$1")" ]; }
# join <a> <b>: "a,b" without empty parts
join() { local r="" x; for x in "$@"; do x=${x#,}; x=${x%,}; [ -n "$x" ] && r="$r,$x"; done; echo "${r#,}"; }

# ---------------------------------------------------------------------------------------------------------------- commands
case "$CMD" in
  build)
    if [ "${1:-}" = "--tests" ]; then
      build_framework 1.7 || exit 2; build_testing || exit 2
      [ "$IS_FW" = 1 ] && { echo "framework + harness built: $KIT/TestMod/1.7/Assemblies/$FWASM.Testing.dll"; exit 0; }
      out="$S/jbbuild_${MODNAME}_tests"; rm -rf "$out"; build_mod "$MOD" 1 "$out" 1.7 || exit 2
      echo "test build (not in the mod folder): $(ls "$out"/*.dll)"
    elif [ "$IS_FW" = 1 ]; then
      build_framework 1.7 || exit 2
      build_framework 1.6 || exit 2
      build_testing || exit 2
      ls -l "$KIT"/1.7/Assemblies/*.dll "$KIT"/1.6/Assemblies/*.dll "$KIT"/TestMod/1.7/Assemblies/*.dll | awk '{print $5, $NF}'
      echo "note: 1.6 is compile-only (Krafs reference assemblies), best effort; there is no 1.6 game here to run it"
    else
      build_framework 1.7 || exit 2
      build_mod "$MOD" 0 - 1.7 || exit 2
      ls -l "$MOD"/1.7/Assemblies/*.dll 2>/dev/null | awk '{print $5, $NF}'
      if grep -q '<li>1.6</li>' "$ABOUT" && [ ! -f "$MOD/Source/Frozen16.sha256" ]; then
        build_framework 1.6 || exit 2
        build_mod "$MOD" 0 - 1.6 || exit 2
        ls -l "$MOD"/1.6/Assemblies/*.dll 2>/dev/null | awk '{print $5, $NF}'
        echo "note: 1.6 is compile-only (Krafs reference assemblies), best effort, NOT runnable here (no 1.6 game on this machine)"
      elif [ -f "$MOD/Source/Frozen16.sha256" ]; then echo "1.6: frozen (Source/Frozen16.sha256), not rebuilt"
      else echo "1.6: not in About supportedVersions, not built"; fi
    fi ;;
  test)
    defaults; SUITES=${1:?suites}; shift
    LABEL="${MODNAME}_test"
    if [ $# -gt 0 ] && is_label "$1"; then LABEL=$1; shift; fi
    EXTRA=("$@")
    run_slot; [ -f "$S/jb_settings_dump_$LABEL.json" ] && echo "settings dump: $S/jb_settings_dump_$LABEL.json"
    exit $RUN_RC ;;
  plain)
    defaults; TIMEOUT_S=${1:?seconds}; shift; KIND=plain; PROBE_DAYS=1; LABEL="${MODNAME}_plain"
    while [ $# -gt 0 ]; do
      case "$1" in --days) PROBE_DAYS=${2:?days}; shift 2;; --no-day) PROBE_DAYS=""; shift;; *) EXTRA+=("$1"); shift;; esac
    done
    [ -z "$PROBE_DAYS" ] && echo "--no-day: the probe only records red errors; the mod's own code drives the game and writes PROBE DONE into \$JB_PROBE_OUT"
    run_slot
    echo "did-not-load-any-content lines: $(grep -c 'did not load any content' "$LOG" 2>/dev/null)"
    [ "$OURS" -gt 0 ] && RUN_RC=1
    [ $RUN_RC = 4 ] && [ "$OURS" = 0 ] && grep -q "Initializing new game" "$LOG" && { echo "(timeout before the probe day ended, but the game started)"; RUN_RC=0; }
    exit $RUN_RC ;;
  play)
    days=${1:?days}; shift
    to=${TIMEOUT:-$((300 + 240 * days))}
    exec "$0" "$MODARG" plain "$to" --days "$days" "$@" ;;
  saveload)
    L=${MODNAME}_saveload; SB=""; SL=""; EX=()
    if [ $# -gt 0 ] && is_label "$1"; then L=$1; shift; fi
    while [ $# -gt 0 ]; do
      case "$1" in --suites) SB=$(join "$SB" "$2"); SL=$(join "$SL" "$2"); shift 2;; --build) SB=$(join "$SB" "$2"); shift 2;;
                   --load) SL=$(join "$SL" "$2"); shift 2;; *) EX+=("$1"); shift;; esac
    done
    two_phase "$L" "$(join "$SB" kit.saveload)" "$(join kit.saveload "$SL")" ${EX[@]+"${EX[@]}"} -- ${EX[@]+"${EX[@]}"}; exit $? ;;
  twophase)
    L=${1:?label}; SU=${2:?suites}; shift 2
    two_phase "$L" "$SU" "$SU" "$@" -- "$@"; exit $? ;;
  removal)
    L=${MODNAME}_saveload; SB=""; EX=()
    if [ $# -gt 0 ] && is_label "$1"; then L=$1; shift; fi
    while [ $# -gt 0 ]; do case "$1" in --build) SB=$(join "$SB" "$2"); shift 2;; *) EX+=("$1"); shift;; esac; done
    D="$S/jb_saveload_$L"; BUILDKEY=$L
    if [ -z "$(newest_save "$D/build")" ]; then
      defaults; LABEL="${L}_build"; SUITES=$(join "$SB" kit.saveload); SAVES_OUT="$D/build"; EXTRA=(${EX[@]+"${EX[@]}"}); rm -rf "$D/build"
      echo "== phase build: new game with the mod ${EX[*]+${EX[*]}} → save ($SUITES)"; run_slot; rc_build=$RUN_RC
      [ -z "$(newest_save "$D/build")" ] && { echo "phase build made no save"; exit 1; }
      [ $rc_build != 0 ] && { echo "phase build failed ($rc_build)"; exit $rc_build; }
    fi
    defaults; LABEL="${L}_removal"; LOAD=$(newest_save "$D/build"); NO_MOD=1; PROBE_DAYS=1; KIND=plain; EXTRA=(${EX[@]+"${EX[@]}"})
    PROBE_SAVE=${JB_PROBE_SAVE:-jb_removal_end}; SAVES_OUT="$D/removal_out"; rm -rf "$D/removal_out"
    echo "== phase removal: load $(basename "$LOAD") WITHOUT the mod (the framework stays${EX[*]+, and ${EX[*]}}), play 1 day"; run_slot
    echo "removal answer: $OURS red error(s) naming the mod or the framework ($OURS_PLAY while playing); see the list above"
    grep '^colonist ' "$POUT" 2>/dev/null | sed 's/^/  left the colony: /'
    [ -f "$D/removal_out/$PROBE_SAVE.rws" ] && echo "end save (1 day without the mod): $D/removal_out/$PROBE_SAVE.rws"
    [ "$OURS" -gt 0 ] && [ $RUN_RC = 0 ] && RUN_RC=1
    exit $RUN_RC ;;
  addition)
    L=${MODNAME}_addition; SA=""; EX=()
    if [ $# -gt 0 ] && is_label "$1"; then L=$1; shift; fi
    while [ $# -gt 0 ]; do case "$1" in --suites) SA=$(join "$SA" "$2"); shift 2;; *) EX+=("$1"); shift;; esac; done
    D="$S/jb_saveload_$L"; BUILDKEY=$L
    defaults; LABEL="${L}_vanilla"; NO_MOD=1; NO_FW=1; PROBE_DAYS=0; PROBE_SAVE=jb_vanilla; SAVES_OUT="$D/vanilla"; KIND=plain; EXTRA=(${EX[@]+"${EX[@]}"}); rm -rf "$D/vanilla"
    echo "== phase vanilla: new game WITHOUT the mod and WITHOUT the framework ${EX[*]+(with ${EX[*]}) }→ save"; run_slot
    [ -f "$D/vanilla/jb_vanilla.rws" ] || { echo "phase vanilla made no save"; exit 1; }
    defaults; LABEL="${L}_addition"; LOAD="$D/vanilla/jb_vanilla.rws"; SUITES=$(join kit.smoke kit.addition "$SA"); EXTRA=(${EX[@]+"${EX[@]}"})
    echo "== phase addition: load the vanilla save WITH the framework and the mod ($SUITES)"; run_slot; exit $RUN_RC ;;
  compat)
    # compat <set> [label] [--suites a,b]: kit.smoke (+ the suites) with a named set of other mods (tools/compat_sets.json; an entry may
    # be a packageId or a folder, e.g. one specific cached Workshop item)
    set_name=${1:?set}; shift; L=${MODNAME}_compat_$set_name; CS=""
    while [ $# -gt 0 ]; do case "$1" in --suites) CS=$(join "$CS" "$2"); shift 2;; *) L=$1; shift;; esac; done
    entries=$(python3 -I - "$KIT/tools/compat_sets.json" "$set_name" <<'PY'
import json, os, sys
sets = json.load(open(sys.argv[1])); name = sys.argv[2]
if name not in sets: print("ERROR unknown set; known: " + ", ".join(k for k in sets if not k.startswith("_"))); sys.exit(0)
for e in sets[name]: print(os.path.expanduser(e))
PY
)
    echo "$entries" | grep -q '^ERROR' && { echo "$entries"; exit 2; }
    defaults; LABEL=$L; SUITES=$(join kit.smoke "$CS")
    while IFS= read -r e; do [ -n "$e" ] && EXTRA+=("$e"); done <<< "$entries"
    for e in "${EXTRA[@]}"; do
      line=$(python3 -I "$KIT/tools/resolve_mods.py" "$e"); echo "$line"
      case "$line" in MISSING*) echo "a mod of the set is not available (not installed, not in the Rimling cache)"; exit 2;; esac
    done
    run_slot; exit $RUN_RC ;;
  load)
    # load <save.rws> [label] [--suites S] [--days N] [--save NAME] [--no-mod] [--no-fw] [extra…]: a GIVEN save with the current build
    # (adopted from the integration run's _loadwith; FW requests DNDM F2, HBG2 2, SMD 17)
    SVF=${1:?save file}; shift; [ -f "$SVF" ] || { echo "no save $SVF"; exit 2; }; SVF="$(cd "$(dirname "$SVF")" && pwd)/$(basename "$SVF")"
    defaults; LABEL="${MODNAME}_load"; [ $# -gt 0 ] && is_label "$1" && { LABEL=$1; shift; }
    LOAD=$SVF; KIND=plain; PROBE_DAYS=1; SAVES_OUT="$S/jb_load_$LABEL"; rm -rf "$SAVES_OUT"
    while [ $# -gt 0 ]; do case "$1" in --no-mod) NO_MOD=1; shift;; --no-fw) NO_FW=1; shift;; --days) PROBE_DAYS=${2:?days}; shift 2;;
      --suites) SUITES=${2:?suites}; KIND=tests; PROBE_DAYS=""; shift 2;; --save) PROBE_SAVE=${2:?name}; shift 2;; *) EXTRA+=("$1"); shift;; esac; done
    echo "== load $(basename "$SVF") $([ "$NO_MOD" = 1 ] && echo without || echo with) $MODNAME${SUITES:+, suites $SUITES}${PROBE_DAYS:+, probe plays $PROBE_DAYS day(s)}"
    run_slot; echo "saves out: $SAVES_OUT"; [ "$OURS" -gt 0 ] && [ $RUN_RC = 0 ] && RUN_RC=1; exit $RUN_RC ;;
  _loadwith)   # the integration run's name for `load` (kept for its scripts): _loadwith <label> <save> [options…]
    L=${1:?label}; SVF=${2:?save}; shift 2; exec "$0" "$MODARG" load "$SVF" "$L" "$@" ;;
  noframework)
    # noframework [label] [extra…]: the mod (and local extras with a guard) WITHOUT the framework; see the usage at the top
    defaults; LABEL="${MODNAME}_nofw"; [ $# -gt 0 ] && is_label "$1" && { LABEL=$1; shift; }
    EXTRA=("$@"); NO_FW=1; KIND=plain; GUARD_RUN=1; GUARD_ARGS="-p:JBGuardBuild=true -p:JBGuardTests=true"
    [ "$IS_FW" = 1 ] && { echo "noframework needs a dependent mod (with <JBGuard>true</JBGuard>)"; exit 2; }
    TIMEOUT_S=${TIMEOUT:-300}
    run_slot
    echo "did-not-load-any-content lines: $(grep -c 'did not load any content' "$LOG" 2>/dev/null)"
    [ "$(grep -c 'did not load any content' "$LOG" 2>/dev/null)" -gt 0 ] 2>/dev/null && RUN_RC=1
    # the mod list the faked install saved: the framework directly above the first guarded mod
    MC="$S/jb_logs_$LABEL/ModsConfig_after.xml"
    XP=(); for e in ${EXTRA[@]+"${EXTRA[@]}"}; do d=$(resolve_dir "$e"); [ -n "$d" ] && XP+=("$(pid_of "$d" | tr '[:upper:]' '[:lower:]')"); done
    python3 -I - "$MC" "$FWPID" "$PIDL" ${XP[@]+"${XP[@]}"} <<'PY2' || RUN_RC=1
import re, sys
p, fw, mod = sys.argv[1:4]
try: ids = re.findall(r"<li>([^<]+)</li>", open(p, encoding="utf-8").read().split("</activeMods>")[0])
except OSError: print("ModsConfig after the run: missing"); sys.exit(1)
plain = [re.sub(r"\.slot\d+$", "", i.lower()) for i in ids]
at = plain.index(fw) if fw in plain else -1
first = next((n for n, i in enumerate(plain) if i == mod or i in sys.argv[4:]), -1)
print(f"ModsConfig after the faked install: {' '.join(ids)}")
ok = at >= 0 and first == at + 1
print(("PASS" if ok else "FAIL") + f": framework at {at}, first guarded mod at {first} (guarded: {', '.join(sys.argv[3:])})")
sys.exit(0 if ok else 1)
PY2
    exit $RUN_RC ;;
  migrate-test)
    from=""; cls=""; L="${MODNAME}_migrate"
    while [ $# -gt 0 ]; do case "$1" in --from) from=$2; shift 2;; --class) cls=$2; shift 2;; *) L=$1; shift;; esac; done
    [ -z "$cls" ] && cls=$(mod_class)
    if [ -z "$from" ]; then
      for f in "$REALCFG/Mod_${MODNAME}_${cls}.xml" "$REALCFG"/Mod_*_"${cls}".xml; do [ -f "$f" ] && { from=$f; break; }; done
      [ -z "$from" ] && { echo "no settings file Mod_*_${cls}.xml in the player's config; pass --from FILE"; exit 2; }
      echo "old settings: a copy of $(basename "$from") (the original is only read)"
    else
      [ -f "$from" ] || from="$MOD/$from"; [ -f "$from" ] || { echo "no such file: $from"; exit 2; }
    fi
    defaults; LABEL=$L; SUITES=kit.migration,kit.smoke; MIGRATION_FROM=$from; MIGRATION_CLASS=$cls
    run_slot; exit $RUN_RC ;;
  fw)
    A="$KIT/sample/KitSampleA"; B="$KIT/sample/KitSampleB"; sc=${1:?scenario: tenants|removal|apilevel|alone|all}
    case "$sc" in
      tenants)  exec "$0" "$A" _two fw_tenants fw.tenants "$B" -- "$B" ;;
      removal)  "$0" "$A" _two fw_removal fw.removal "$B" -- ; rc=$?; [ $rc = 0 ] || exit $rc
                echo "== phase 3: load the save made WITHOUT sample B with sample B again"; exec "$0" "$A" _back fw_removal jb_fw_removal_again "$B" ;;
      apilevel) JB_MSBUILD_ARGS="-p:JBMinApiLevel=99" exec "$0" "$A" test fw.apilevel fw_apilevel "$B" ;;
      alone)    exec "$0" "$KIT" test fw.alone fw_alone ;;
      cards)    exec "$0" "$RW/RimWard" test fw.cards fw_cards "$RW/LuciferiumOverhaul" "$RW/BetterWorkbenchDefaults" "$RW/HospitalBedsGen2" ;;
      all)
        res=""; for x in alone tenants removal apilevel cards; do "$0" "$MODARG" fw "$x" > "$S/jb_fw_$x.out" 2>&1; rc=$?; res="$res $x=$rc"; echo "fw $x: exit $rc ($S/jb_fw_$x.out)"; done
        echo "fw all:$res"; echo "$res" | grep -q '=[1-9]' && exit 1; exit 0 ;;
      *) echo "unknown scenario $sc"; exit 2 ;;
    esac ;;
  _two) L=$1; SU=$2; shift 2; two_phase "$L" "$SU" "$SU" "$@"; exit $? ;;   # internal (fw scenarios): <label> <suites> <extras 1…> -- <extras 2…>
  _back)   # <label> <save name in phase 2's saves> <extras…>: load a save of phase 2 again (fw removal phase 3)
    L=$1; SVN=$2; shift 2; D="$S/jb_saveload_$L"
    [ -f "$D/load/$SVN.rws" ] || { echo "phase 2 made no save $SVN"; exit 1; }
    BUILDKEY=$L; defaults; LABEL="${L}_back"; SUITES=fw.removal; LOAD="$D/load/$SVN.rws"; EXTRA=("$@"); BUILD=0 run_slot; exit $RUN_RC ;;
  freeze16) py freeze16.py "$MOD" "$@" ;;
  release) py release.py "$MOD" "$@" ;;
  desc-lint)
    if [ $# -gt 0 ] && [ -f "$1" ]; then py desc_lint.py "$@" --mod "$MOD"; else py desc_lint.py "$MOD/Workshop/description.bbcode" --mod "$MOD" "$@"; fi ;;
  lang)
    # read only unless --write or --refresh: a reviewer can check the translations without touching the mod
    if [ "${1:-}" = "--refresh" ]; then
      shift; defaults; LABEL="${MODNAME}_dump"; SUITES=kit.settingsdump
      run_slot; [ $RUN_RC = 0 ] || { echo "kit.settingsdump failed"; exit $RUN_RC; }
      mkdir -p "$MOD/Source"; cp "$S/jb_settings_dump_$LABEL.json" "$MOD/Source/settings_dump.json" && echo "dump → Source/settings_dump.json"
      py kit_lang.py "$MOD" --write "$@" && py kit_lang.py "$MOD" --check "$@"; exit $?
    fi
    if [ "${1:-}" = "--write" ]; then shift; py kit_lang.py "$MOD" --write "$@" && py kit_lang.py "$MOD" --check "$@"; exit $?; fi
    py kit_lang.py "$MOD" --check "$@" ;;
  *) usage ;;
esac
