<Project Sdk="Microsoft.NET.Sdk">
  <!--
    JB Framework in-game test harness: assembly JBFramework.Testing.dll in the LOCAL test mod TestMod/ (packageId
    juliusberger.jbframework.testing). Never published, never shipped: tools/jbmod loads it only in test runs, and dependent mods
    reference it only in test builds (-p:JBTests=true, build/JBMod.props). SPDX-License-Identifier: MIT

      dotnet build TestMod/Source -c Release      → TestMod/1.7/Assemblies/JBFramework.Testing.dll (needs 1.7/Assemblies/JBFramework.dll)

    It sees the framework's internals ([assembly: InternalsVisibleTo("JBFramework.Testing")], generated by build/JBFramework.props).
    RimWorld 1.7 only (the test runs need the game).
  -->
  <Import Project="$(MSBuildProjectDirectory)/../../build/Identity.props" />
  <Import Project="$(MSBuildProjectDirectory)/../../build/JBCommon.props" />
  <PropertyGroup>
    <JBFrameworkRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/../..'))</JBFrameworkRoot>
    <AssemblyName>$(JBFrameworkAssemblyName).Testing</AssemblyName>
    <RootNamespace>$(JBFrameworkNamespace).Testing</RootNamespace>
    <OutputPath>$(MSBuildProjectDirectory)/../$(RimVersion)/Assemblies/</OutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1591;CS8632;CA1416</NoWarn>
    <_JBFrameworkDll>$(JBFrameworkRoot)$(RimVersion)/Assemblies/$(JBFrameworkAssemblyName).dll</_JBFrameworkDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(JBFrameworkAssemblyName)"><HintPath>$(_JBFrameworkDll)</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <Target Name="JBTestingGuard" BeforeTargets="CoreCompile;BeforeBuild">
    <Error Condition="'$(RimVersion)' != '1.7'" Text="JBFramework.Testing is RimWorld 1.7 only (the test runs need the game)." />
    <Error Condition="!Exists('$(_JBFrameworkDll)')" Text="Build the framework first: dotnet build $(JBFrameworkRoot)Source/JBFramework -c Release" />
  </Target>
</Project>
